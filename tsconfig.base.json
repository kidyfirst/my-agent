{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"paths": {
			"@my-agent/core": ["./packages/core/src/index.ts"],
			"@my-agent/core/*": ["./packages/core/src/*"],
			"@my-agent/a2a": ["./packages/a2a/src/index.ts"],
			"@my-agent/a2a/*": ["./packages/a2a/src/*"],
			"@my-agent/evals": ["./packages/evals/src/index.ts"],
			"@my-agent/evals/*": ["./packages/evals/src/*"]
		}
	}
}
