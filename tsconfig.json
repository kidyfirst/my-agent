{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"outDir": "dist",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@my-agent/core": ["packages/core/src/index.ts"],
			"@my-agent/a2a": ["packages/a2a/src/index.ts"],
			"@my-agent/cli": ["packages/cli/src/index.ts"]
		}
	},
	"include": [
		"apps/desktop/src/**/*",
		"packages/*/src/**/*",
		"electron-vite.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"apps/desktop/src/**/__tests__/**",
		"packages/**/__tests__/**",
		"packages/**/tests/**"
	]
}
