{
	"name": "@my-agent/cli",
	"version": "0.1.3",
	"description": "Command line interface and local daemon for My Agent",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"my-agent": "./bin/my-agent.js"
